{
  "name": "@anvilwing/vigil-robotics",
  "version": "0.1.0",
  "description": "Vigil Robotics — LLM-based autonomous robotics control framework with sensor-to-text pipeline and ROS integration for multi-platform robot control (Boston Dynamics, Universal Robots, KUKA, ABB, Franka, and ROS-compatible platforms).",
  "main": "dist/bin/vigil.js",
  "exports": {
    ".": "./dist/bin/vigil.js",
    "./lean": "./dist/leanAgent.js",
    "./robotics": "./dist/robotics/index.js",
    "./robotics/sensor": "./dist/robotics/sensor.js",
    "./robotics/actuator": "./dist/robotics/actuator.js",
    "./robotics/navigation": "./dist/robotics/navigation.js",
    "./robotics/safety": "./dist/robotics/safety.js",
    "./robotics/ros": "./dist/robotics/ros.js",
    "./robotics/hardware": "./dist/robotics/hardware.js",
    "./robotics/perception": "./dist/robotics/perception.js",
    "./robotics/simulation": "./dist/robotics/simulation.js",
    "./robotics/control": "./dist/robotics/control.js",
    "./tools": "./dist/tools/public/index.js"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "agents",
    "LICENSE",
    "scripts/ros-mcp.mjs",
    "scripts/gazebo-mcp.mjs",
    "scripts/robot-safety-mcp.mjs"
  ],
  "bin": {
    "vigil": "dist/bin/vigil.js"
  },
  "scripts": {
    "clean": "node -e \"const { rmSync } = require('fs'); for (const target of ['dist', '.tsbuildinfo']) { try { rmSync(target, { recursive: true, force: true, maxRetries: 10 }); } catch (error) { console.warn('Clean warning:', error.code, 'for', target); } }\"",
    "build": "tsc -p tsconfig.json --skipLibCheck || true",
    "build:watch": "tsc --watch",
    "build:prod": "NODE_ENV=production MINIFY=true npm run build",
    "prebuild": "npm run clean",
    "pretest": "npm run build",
    "postbuild": "node scripts/postbuild.mjs",
    "cli": "node dist/bin/vigil.js",
    "dev": "node --loader ts-node/esm src/bin/vigil.ts",
    "dev:watch": "node --watch --loader ts-node/esm src/bin/vigil.ts",
    "start": "node dist/bin/vigil.js",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:coverage": "jest --config jest.config.cjs --coverage",
    "lint": "eslint src/**/*.ts --max-warnings 200",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "ros:mcp": "node scripts/vigil-run.mjs scripts/ros-mcp.mjs",
    "gazebo:mcp": "node scripts/vigil-run.mjs scripts/gazebo-mcp.mjs",
    "safety:mcp": "node scripts/vigil-run.mjs scripts/robot-safety-mcp.mjs"
  },
  "keywords": [
    "robotics",
    "llm",
    "autonomous-robots",
    "sensor-fusion",
    "ros",
    "boston-dynamics",
    "spot",
    "atlas",
    "universal-robots",
    "kuka",
    "abb",
    "franka",
    "kinova",
    "mcp",
    "cli",
    "agent",
    "ai",
    "typescript"
  ],
  "author": "Anvilwing (https://anvilwing.org)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anvilwing/vigil-robotics.git"
  },
  "bugs": {
    "url": "https://github.com/anvilwing/vigil-robotics/issues"
  },
  "homepage": "https://github.com/anvilwing/vigil-robotics#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^9.39.4",
    "@types/glob": "^8.1.0",
    "@types/gradient-string": "^1.1.6",
    "@types/jest": "30.0.0",
    "@types/node": "25.9.3",
    "@types/react": "^19.2.17",
    "@typescript-eslint/eslint-plugin": "8.49.0",
    "@typescript-eslint/parser": "8.49.0",
    "@xterm/headless": "^6.0.0",
    "babel-jest": "^30.4.1",
    "eslint": "9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "firebase-tools": "^15.20.0",
    "ink-testing-library": "^4.0.0",
    "jest": "30.2.0",
    "node-pty": "^1.1.0",
    "nodemailer": "^9.0.1",
    "ts-jest": "29.4.6",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.61.0"
  },
  "overrides": {
    "uuid": "^14.0.0"
  },
  "optionalDependencies": {
    "playwright": "^1.60.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "cli-spinners": "^3.4.0",
    "gradient-string": "^3.0.0",
    "ink": "^6.8.0",
    "ink-spinner": "^5.0.0",
    "nanospinner": "1.2.2",
    "open": "^11.0.0",
    "openai": "^6.42.0",
    "ora": "^9.4.0",
    "react": "^19.2.7",
    "react-devtools-core": "^7.0.1",
    "typescript": "5.9.3",
    "zod": "^3.25.76"
  }
}
