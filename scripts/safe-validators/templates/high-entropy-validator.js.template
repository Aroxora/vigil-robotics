#!/usr/bin/env node
/**
 * SAFE DEFENSIVE VALIDATOR — HIGH ENTROPY STRING / POTENTIAL SECRET PROOF
 *
 * Purpose: Scans for high-entropy strings (potential secrets/keys) in a bounded way.
 *          Read-only, evidence only. No exfil or use of the strings.
 *
 * Generated by Vigil (keep going iteration).
 */

import { readFileSync, existsSync } from 'node:fs';
import { resolve } from 'node:path';

function entropy(s) {
  const freq = {}; for (const c of s) freq[c] = (freq[c]||0)+1;
  let e = 0; const n = s.length;
  for (const c in freq) { const p = freq[c]/n; e -= p * Math.log2(p); }
  return e;
}

const args = process.argv.slice(2);
const root = args[args.indexOf('--root')+1] || process.cwd();
const minLen = 40;
const started = new Date().toISOString();

const evidence = {
  validator: 'high-entropy-validator',
  schemaVersion: '1.0.0',
  generatedBy: 'Vigil safe-poc-generator (keep going)',
  startedAt: started,
  root: resolve(root),
  candidates: [],
  conclusion: '',
};

function scan(d, depth=0) {
  if (depth > 4) return;
  try {
    const fs = require('fs');
    for (const e of fs.readdirSync(d, {withFileTypes:true})) {
      if (e.name === 'node_modules' || e.name.startsWith('.')) continue;
      const p = require('path').join(d, e.name);
      if (e.isDirectory()) scan(p, depth+1);
      else if (/\.(js|ts|mjs|json|env|yml|yaml|sh|ps1)$/.test(e.name)) {
        const txt = fs.readFileSync(p, 'utf8');
        const longs = txt.match(/[A-Za-z0-9+/=]{40,}/g) || [];
        for (const l of longs) {
          if (entropy(l) > 4.5) {
            evidence.candidates.push({ file: require('path').relative(root, p), entropy: entropy(l).toFixed(2), sample: l.slice(0,20)+'…' });
          }
        }
      }
    }
  } catch {}
}

scan(resolve(root));
evidence.candidates = evidence.candidates.slice(0, 20);
evidence.completedAt = new Date().toISOString();
evidence.conclusion = evidence.candidates.length ? `${evidence.candidates.length} high-entropy candidates found (review for secrets).` : 'No high-entropy strings above threshold in quick scan.';

console.log(JSON.stringify(evidence, null, 2));
process.exit(0);
