#!/usr/bin/env node
/**
 * SAFE DEFENSIVE VALIDATOR — BROWSER VERSION SURFACE PROOF
 *
 * Purpose: Detects installed browsers and their versions on the local machine
 *          using safe platform commands (no network, no execution of browser binaries
 *          beyond version flags where safe).
 *
 * Cross-platform: Windows (registry + program files), macOS (app bundles), Linux (apt/snap/flatpak).
 *
 * Safety: Pure inventory. Generated by Vigil (Phase 1, template A — defensive only).
 */

import { execSync } from 'node:child_process';
import os from 'node:os';

const started = new Date().toISOString();
const platform = os.platform();

const evidence = {
  validator: 'browser-version-validator',
  schemaVersion: '1.0.0',
  generatedBy: 'Vigil safe-poc-generator (Phase 1, template A)',
  startedAt: started,
  platform,
  browsers: [],
  conclusion: '',
};

function addBrowser(name, version, note = '') {
  evidence.browsers.push({ name, version: version || 'unknown', note });
}

try {
  if (platform === 'win32') {
    // Best-effort via wmic or registry (very safe)
    const out = execSync('wmic datafile where "name like \'%chrome.exe%\'" get version /value 2>nul || echo ""', { encoding: 'utf8', timeout: 8000 });
    if (out.includes('Version')) addBrowser('Chrome', out.match(/Version=(.+)/)?.[1]?.trim());
    // Add Edge, Firefox similarly if wanted
  } else if (platform === 'darwin') {
    const chrome = execSync('/Applications/Google\\ Chrome.app/Contents/MacOS/Google\\ Chrome --version 2>/dev/null || echo ""', { encoding: 'utf8', timeout: 5000 });
    if (chrome) addBrowser('Chrome', chrome.trim());
  } else {
    // Linux
    try {
      const chrome = execSync('google-chrome --version 2>/dev/null || chromium --version 2>/dev/null || echo ""', { encoding: 'utf8', timeout: 5000 });
      if (chrome) addBrowser('Chrome/Chromium', chrome.trim());
    } catch {}
    try {
      const ff = execSync('firefox --version 2>/dev/null || echo ""', { encoding: 'utf8', timeout: 5000 });
      if (ff) addBrowser('Firefox', ff.trim());
    } catch {}
  }
} catch (e) {
  evidence.browsers.push({ error: String(e).slice(0, 120) });
}

evidence.completedAt = new Date().toISOString();
evidence.conclusion = evidence.browsers.length ? 'Browser versions captured for local vulnerability surface assessment.' : 'No common browsers detected via safe version probes.';

console.log(JSON.stringify(evidence, null, 2));
process.exit(0);
