#!/usr/bin/env bash
# SAFE DEFENSIVE VALIDATOR — LOCAL LISTENER / PORT EXPOSURE PROOF
#
# Purpose: Enumerates listening TCP/UDP sockets on the operator's own host to
#          prove exposure of a service (e.g., an unexpectedly open database port
#          or management interface) without any remote interaction or exploitation.
#
# Safety: 100% read-only local netstat/ss/ss -l / Get-NetTCPConnection equivalent.
#          Never connects outbound. Never scans other hosts.
#
# Cross-platform: Prefers ss (Linux), netstat fallback, PowerShell on Windows.
# Run with bash on *nix or Git Bash/WSL on Windows, or PowerShell equivalent.
#
# Generated by Vigil safe-poc-generator (template A — pure defensive).
# Review the command before execution. Produces evidence JSON.

set -euo pipefail

PKG=${1:-"unknown-service"}
PORT_HINT=${2:-""}
STARTED=$(date -u +%Y-%m-%dT%H:%M:%SZ)

echo '{
  "validator": "local-listener-validator",
  "schemaVersion": "1.0.0",
  "generatedBy": "Vigil safe-poc-generator (Phase 1, template A)",
  "startedAt": "'"$STARTED"'",
  "target": "'"$PKG"'",
  "portHint": "'"$PORT_HINT"'",
  "platform": "'$(uname -s 2>/dev/null || echo Windows)'",
  "listeners": [],' 

if command -v ss >/dev/null 2>&1; then
  # Linux modern
  LISTENERS=$(ss -tulnp 2>/dev/null | grep -E 'LISTEN|UNCONN' | head -50 || true)
  echo '  "method": "ss -tulnp",'
elif command -v netstat >/dev/null 2>&1; then
  LISTENERS=$(netstat -tulnp 2>/dev/null | grep -E 'LISTEN|UDP' | head -50 || true)
  echo '  "method": "netstat -tulnp",'
else
  # Windows or minimal env — PowerShell if available
  if command -v powershell.exe >/dev/null 2>&1 || command -v pwsh >/dev/null 2>&1; then
    PS="powershell.exe -NoProfile -NonInteractive -Command"
    LISTENERS=$($PS "Get-NetTCPConnection -State Listen | Select-Object LocalAddress,LocalPort,OwningProcess | ConvertTo-Json -Compress" 2>/dev/null || echo '[]')
    echo '  "method": "Get-NetTCPConnection",'
  else
    LISTENERS="[]"
    echo '  "method": "none-available",'
  fi
fi

# Very lightweight JSON (best-effort; in real generator we would properly escape)
echo '  "rawSample": "'$(echo "$LISTENERS" | head -c 2000 | tr '\n' ' ' | sed 's/"/\\"/g')'",'
echo '  "present": true,'
echo '  "conclusion": "Local listener table captured for operator review. Correlate with process inventory for exposure proof.",'
echo '  "completedAt": "'$(date -u +%Y-%m-%dT%H:%M:%SZ)'"'
echo '}'

# Exit 0 = evidence captured (operator decides if concerning)
exit 0
