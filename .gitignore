# dependency + build trees
node_modules
dist
*.tsbuildinfo

# coverage / test artifacts
coverage/
*.lcov

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp
.claude/

# secrets — never commit
.npmrc
.env
.env.local
.env.*.local
secrets.json
**/credentials.json

# per-user local MCP registry (the .example file is tracked instead)
mcp.json

# per-user / per-session local state
.vigil/
.vigil-test-home/
.vigil-test-empty/
.erosolar/
.agi/
.debug-prompts/
**/.debug-prompts/

# logs / temp
*.log
*.tmp

# Xcode
xcuserdata/
*.xcuserstate
DerivedData/

# AWS Lambda build artifacts — recreated by aws/scripts/deploy.sh on every
# push. The zip is the packaged upload. Both were tracked by mistake and
# accumulated commit-by-commit before being ignored.
aws/lambda/build/
aws/lambda/*.zip

# Erosolar_Browser is a separate Electron build with its own outputs
Erosolar_Browser/node_modules/
Erosolar_Browser/build/icon.icns
Erosolar_Browser/build/icon.ico
Erosolar_Browser/build/icon.png
Erosolar_Browser/build/icon.iconset/
Erosolar_Browser/build/icon.svg
Erosolar_Browser/dist/
Erosolar_Browser/out/

# Firebase Hosting / Angular build outputs
site/.firebase/
site/public/dl/
site/vigil-app/.angular/
site/vigil-app/dist/

# Generated by scripts/security-analysis.mjs upload step. The binary
# tarball + findings json/md are served by Firebase Hosting at /dl/*
# and /security/*; they're regenerated on every analysis run so we
# don't track them in git.
site/vigil-app/public/dl/
site/vigil-app/public/security/

# npm pack output — we DO upload the tarball to Firebase Storage, but
# don't track binary tarballs in git
*.tgz
*.tar.gz

# Defensive dep-audit findings (legacy)
audit-findings/

# Real security analysis output — written to disk by scripts/security-analysis.mjs
# (also uploaded to Firestore and Firebase Storage; not tracked in git)
security-analysis/

# UI/PTY tests can stash terminal recordings
test/ui-pty/artifacts/
tools/eccn-restricted/
tools/vigil-pentest.py
__pycache__/
