# Vigil requires two API keys. Copy this file to `.env` (gitignored) and fill in
# your own values, or export them in your shell, or run:
#     vigil --key sk-...
#     vigil --tavily-key tvly-...
# to persist them to ~/.vigil/secrets.json with 0600 perms.

DEEPSEEK_API_KEY=your-deepseek-key-here
TAVILY_API_KEY=your-tavily-key-here

# Optional. Defaults to ~/.vigil/.
# VIGIL_HOME=
# VIGIL_PROFILE=vigil-code
